test "truncating any frame at any length is an error, never a read past the end" {
    const alloc = testing.allocator;
    const msgs = [_]Message{ sampleMoment(), sampleVerdict(), sampleNote(), sampleHandoff(), .bye };
    for (msgs) |msg| {
