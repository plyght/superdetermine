    defer s.deinit();
    const path = rest[0];
    const maybe = attribution.lastForPath(&s, alloc, path) catch null;
    const e = maybe orelse {
        try w.print("{s}\n  \u{21b3} no attribution yet (save it, or it predates auto-provenance)\n", .{path});
