    return store.writeChange(.{
        .tree = tree_oid,
        .parents = parents,
        .change_id = [_]u8{id} ** 16,
        .timestamp = ts,
        .tz_offset_min = 0,
        .author = "Remote <remote@example.com>",
        .message = msg,
    });
}

