test "ranges parse both ends and default sensibly" {
    const alloc = testing.allocator;
    var f = try fixture(alloc);
    defer f.deinit();

    const m1 = try captureAt(&f, alloc, "one", base_ms + 1000, .save);
    alloc.free(m1.branch);
