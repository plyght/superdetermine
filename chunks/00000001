    }

    try testing.expect((try endpointFromRemote(alloc, "file:///tmp/bare")) == null);
    try testing.expect((try endpointFromRemote(alloc, "/tmp/bare")) == null);
    try testing.expect((try endpointFromRemote(alloc, "")) == null);
}

