    const expected = it.next() orelse "";

    const data = std.Io.Dir.cwd().readFileAlloc(io, tmp, alloc, .unlimited) catch {
        std.Io.Dir.cwd().deleteFile(io, tmp) catch {};
        try w.writeAll("sdt update: could not read downloaded binary\n");
        return;
