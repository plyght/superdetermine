    var b = Broadcaster.init(io) catch return;
    defer b.deinit(io);
    while (!stop.load(.acquire)) {
        _ = b.pulse(io, slot, tcp_port);
        io.sleep(.{ .nanoseconds = 100 * std.time.ns_per_ms }, .awake) catch return;
    }
}

