    try keyring.saveManifest(io, alloc, work, &manifest);

    try work.writeFile(io, .{ .sub_path = ".sdtignore", .data = ".env\n" });
    try work.writeFile(io, .{ .sub_path = ".env", .data = "API_KEY=sk-live-1\n" });

