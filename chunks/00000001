                dropped += 1;
                continue;
            }
        } else |_| {}
        try kept.appendSlice(alloc, t);
        try kept.append(alloc, '\n');
    }

    if (dropped == 0) return 0;
    try store.root.writeFile(store.io, .{ .sub_path = "gitmap", .data = kept.items });
    return dropped;
}

