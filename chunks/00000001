    const results = [_]verdict.Result{ .green, .green, .red, .red, .red, .green, .green };
    var list: [results.len]moment.Moment = undefined;
    for (&list, 0..) |*m, i| {
        m.* = fakeMoment(i, base_ms + @as(i64, @intCast(i)) * 1000);
        try recordResult(&store, m.*, cmd, results[i]);
