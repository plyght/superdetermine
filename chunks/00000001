	cl_git_fail(git_odb__hashfile(&a, "status/testfile.txt", 0, GIT_OID_SHA1));
	cl_git_fail(git_repository_hashfile(&b, _repo, "testfile.txt", GIT_OBJECT_ANY, NULL));

	git_str_dispose(&txt);
	git_str_dispose(&bin);
	git_str_dispose(&root);
