fn gradeContext(
    alloc: std.mem.Allocator,
    s: *Store,
    work: std.Io.Dir,
    set: checks.Settings,
    rules: warrant.PathRules,
) grade.Context {
    return .{
        .store = s,
        .work_dir = work,
        .alloc = alloc,
