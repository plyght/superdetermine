    var saw_sealed = false;
    for (tree.entries) |e| {
        try testing.expect(!std.mem.eql(u8, e.path, ".env"));
        try testing.expect(!std.mem.eql(u8, e.path, ".env.sealed"));
        if (std.mem.eql(u8, e.path, seal.manifest_name)) {
