static void assert_ignored_(
	bool expected, const char *filepath,
	const char *file, const char *func, int line)
{
	int is_ignored = 0;
	cl_git_expect(
		git_status_should_ignore(&is_ignored, g_repo, filepath), 0, file, func, line);
