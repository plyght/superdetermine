void test_filter_file__apply(void)
{
	git_filter_list *fl;
	git_filter *crlf;
	git_buf buf = GIT_BUF_INIT;

	cl_git_pass(git_filter_list_new(
		&fl, g_repo, GIT_FILTER_TO_ODB, 0));

	crlf = git_filter_lookup(GIT_FILTER_CRLF);
