		} raw;
	} data;
	unsigned int raw:1;
};

#define GIT_ERROR_CHECK_BLOBSIZE(n) \
	do { \
		if (!git__is_sizet(n)) { \
			git_error_set(GIT_ERROR_NOMEMORY, "blob contents too large to fit in memory"); \
			return -1; \
		} \
	} while(0)

