    defer work.close(io);

    // A repo wide enough that a full tree is meaningfully large.
    for (0..300) |i| {
        const name = try std.fmt.allocPrint(alloc, "f{d}.txt", .{i});
        defer alloc.free(name);
        try work.writeFile(io, .{ .sub_path = name, .data = "contents" });
