    const o = Oid.ofBytes("hello guardrail");
    var buf: [Oid.len * 2]u8 = undefined;
    const hex = o.toHex(&buf);
    const back = try Oid.fromHex(hex);
    try std.testing.expect(o.eql(back));
    try std.testing.expect(!o.isZero());
