fn matchSegs(pat: []const []const u8, path: []const []const u8) bool {
    if (pat.len == 0) return path.len == 0;
    if (std.mem.eql(u8, pat[0], "**")) {
        if (matchSegs(pat[1..], path)) return true;
        if (path.len > 0) return matchSegs(pat, path[1..]);
