test "exportAll writes full history and multiple branches into fresh repo" {
    ensureInit();
    const io = std.testing.io;
    const alloc = testing.allocator;

    var tmp = std.testing.tmpDir(.{});
    defer tmp.cleanup();

    try tmp.dir.createDirPath(io, "grrepo");
