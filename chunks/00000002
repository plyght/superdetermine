	cl_git_fail_with(GIT_EINVALIDSPEC, git_net_url_parse_http(&conndata,
		"user:pass@[fe80::dcad:beff:fe00:0001/resource"));
	cl_git_fail_with(GIT_EINVALIDSPEC, git_net_url_parse_http(&conndata,
		"[fe80::dcad:beff:fe00:0001:9191/resource"));
	cl_git_fail_with(GIT_EINVALIDSPEC, git_net_url_parse_http(&conndata,
