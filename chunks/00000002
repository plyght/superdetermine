    try check(c.git_treebuilder_insert(null, bld, file_name, &blob_oid, c.GIT_FILEMODE_BLOB));
    var tree_oid: c.git_oid = undefined;
    try check(c.git_treebuilder_write(&tree_oid, bld));
    var gtree: ?*c.git_tree = null;
