        .store = &store,
        .work_dir = work,
        .alloc = alloc,
        .set = .{},
        .rules = .{},
    };
    const r = try tick(&store, work, ctx, .{ .enabled = true, .keyframe_interval = 4 }, .{ .battery_floor = 0 });
    try testing.expect(r.captured);
