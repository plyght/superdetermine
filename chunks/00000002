    pub fn has(self: Settings, tier: verdict.Tier) bool {
        return self.command(tier).len != 0;
    }

    pub fn timeoutMs(self: Settings, tier: verdict.Tier) i64 {
        return switch (tier) {
            .fast => self.timeout_fast_ms,
            .full => self.timeout_full_ms,
        };
