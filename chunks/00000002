    // A ref name carrying every character that could break the framing.
    const awkward = "refs/heads/weird name=with\tequals\nand \\ backslash";
    const in = try makeRefs(alloc, &.{
        .{ "refs/heads/main", hex_a },
        .{ awkward, hex_b },
