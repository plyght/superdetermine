    defer c.git_signature_free(sig);
    var commit_oid: c.git_oid = undefined;
    try check(c.git_commit_create(&commit_oid, repo, "refs/heads/master", sig, sig, null, "initial master\n", gtree, 0, null));
    return commit_oid;
}

