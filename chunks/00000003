    let result = undefined;

    if (!arr) {
        return undefined;
    }

    for (const match of arr.filter(fn)) {
        if (result) {
            throw new Error(`multiple matches in array for ${fn}${message ? ' (' + message + ')': ''}`);
        }

        result = match;
    }

    return result;
}

