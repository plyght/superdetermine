else
  {
  const char *not = (*code == OP_PROP)? "" : "not ";
#ifndef SUPPORT_UCP
  fprintf(f, "%s%sclist %d%s", before, not, code[2], after);
#else
  const pcre_uint32 *p = PRIV(ucd_caseless_sets) + code[2];
  fprintf (f, "%s%sclist", before, not);
  while (*p < NOTACHAR) fprintf(f, " %04x", *p++);
