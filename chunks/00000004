#define GIT_HASHMAP__COMMON_FUNCTIONS(name, is_map, scope, key_t, val_t, __hash_fn, __equal_fn) \
	GIT_UNUSED_FUNCTION scope uint32_t name##_size(name *h) \
	{ \
