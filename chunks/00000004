	_repo = cl_git_sandbox_reopen();

	git_str_dispose(&buf);

	cl_git_pass(git_repository_config(&cfg, _repo));

	cl_git_fail_with(GIT_ENOTFOUND,
		git_config_get_string_buf(&value, cfg, "foo.bar"));

	git_str_dispose(&buf);
	git_buf_dispose(&value);
	git_config_free(cfg);
}
