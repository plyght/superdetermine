		0xa8, 0xbd, 0x74, 0xf5, 0xe0,
	};

	cl_git_pass(git_oid__fromstr(&out, "16a67770b7d8d72317c4b775213c23a8bd74f5e0", GIT_OID_SHA1));
	cl_git_pass(memcmp(out.id, exp, GIT_OID_SHA1_SIZE));

	cl_git_pass(git_oid__fromstr(&out, "16A67770B7D8D72317C4b775213C23A8BD74F5E0", GIT_OID_SHA1));
	cl_git_pass(memcmp(out.id, exp, GIT_OID_SHA1_SIZE));
