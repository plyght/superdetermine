pub const record_chunk_len = 32 * 1024;
pub const max_slot_attempts: u32 = 5;
pub const max_slot: u16 = 99;

pub const Error = error{
    BadCode,
    BadHandshake,
    ConfirmationFailed,
    ProtocolError,
    FrameTooLarge,
    SlotBurned,
    BadRecord,
};

pub const Role = enum {
    sender,
    receiver,

    fn tag(self: Role) u8 {
        return switch (self) {
            .sender => 'S',
            .receiver => 'R',
        };
    }

    fn other(self: Role) Role {
        return switch (self) {
            .sender => .receiver,
            .receiver => .sender,
        };
    }
};

