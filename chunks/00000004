 {
            const d = editDistance(cmd, e.name);
            if (d < best_score) {
                best_score = d;
                best = e.name;
            }
        }
    }
    for (aliases) |a| {
        const d = editDistance(cmd, a.short);
        if (d < best_score) {
            best_score = d;
            best = a.full;
        }
    }
    return best;
}

fn canonical(cmd: []const u8) []const u8 {
    for (aliases) |a| {
        if (eq(cmd, a.short)) return a.full;
    }
    return cmd;
}

pub fn main(init: std.process.Init) !void {
    const alloc = init.gpa;
