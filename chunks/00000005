	void *ptr;

	cl_alloc_limit(1);

	cl_assert(ptr = git__malloc(1));
	cl_assert(git__malloc(1) == NULL);
	git__free(ptr);
	cl_assert(ptr = git__malloc(1));
	git__free(ptr);
