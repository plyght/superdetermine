    const tree = try f.store.writeTree(.{ .entries = &.{} });
    var i: usize = 0;
    const twin = while (i < 8_000_000) : (i += 1) {
        var msg_buf: [32]u8 = undefined;
        const message = try std.fmt.bufPrint(&msg_buf, "twin {d}", .{i});
        const enc = try object.Change.encode(.{
            .tree = tree,
