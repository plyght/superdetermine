    var w = std.Io.Writer.Allocating.fromArrayList(alloc, &out);
    defer out = w.toArrayList();

    try w.writer.writeAll("ab");
    try pad(&w.writer, "ab", 5);
    try w.writer.writeAll("|");
    try testing.expectEqualStrings("ab   |", w.written());
}
