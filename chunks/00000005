test "a checkout run from a nested subdirectory writes to the repo root" {
    const io = std.testing.io;
    const alloc = std.testing.allocator;

    var tmp = std.testing.tmpDir(.{});
    defer tmp.cleanup();

    try tmp.dir.createDirPath(io, "repo/native");
