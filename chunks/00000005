    const frame_len = offsets[1] - offsets[0];
    @memcpy(swapped[0..frame_len], original[offsets[1]..][0..frame_len]);
    @memcpy(swapped[frame_len..][0..frame_len], original[offsets[0]..][0..frame_len]);
