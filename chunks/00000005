void test_network_refspecs__matching(void)
{
	git_refspec spec;

	cl_git_pass(git_refspec__parse(&spec, ":", false));
	cl_assert_equal_s(":", spec.string);
	cl_assert_equal_s("", spec.src);
	cl_assert_equal_s("", spec.dst);

