test "diffLines insert delete modify" {
    const alloc = testing.allocator;
    const old = "alpha\nbeta\ngamma\n";
    const new = "alpha\nBETA\ngamma\ndelta\n";
    const ops = try diffLines(alloc, old, new);
    defer alloc.free(ops);

