        break;
      case Direction.RIGHT:
        offsetY = 48 * 2;
        break;
      case Direction.LEFT:
        offsetY = 48;
        break;
    }

    context.drawImage(this.image.data, offsetX, offsetY, 32, 48, this.pixelX, this.pixelY - 16, 32, 48);
  };
});
