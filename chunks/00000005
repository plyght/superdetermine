}

fn cmdNotes(io: std.Io, alloc: std.mem.Allocator, w: *std.Io.Writer) !void {
    var s = (try openRepo(io, alloc, w)) orelse return;
    defer s.deinit();
    const list = try live.notes(&s, alloc);
    defer live.freeNotes(alloc, list);
    if (list.len == 0) {
        try w.writeAll("no notes\n");
