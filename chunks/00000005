}

test "an unknown kind byte errors cleanly" {
    const alloc = testing.allocator;
    const enc = try encode(alloc, sampleNote());
    defer alloc.free(enc);
    const bad = try alloc.dupe(u8, enc);
    defer alloc.free(bad);
