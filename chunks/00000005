    ensureInit();
    const io = std.testing.io;
    const alloc = testing.allocator;

    var tmp = std.testing.tmpDir(.{});
    defer tmp.cleanup();

    const payload = "PAYLOAD " ** 64;

    try tmp.dir.createDirPath(io, "src");
