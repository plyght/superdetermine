    alloc.free(a.branch);
    const b = try snap(&f, alloc, "a.txt", "good two");
    alloc.free(b.branch);
    const c = try snap(&f, alloc, "a.txt", "broken");
    alloc.free(c.branch);

    const all = try moment.readAll(&f.store, alloc);
    defer moment.freeMoments(alloc, all);
