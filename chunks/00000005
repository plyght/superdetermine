    var follower = Session{
        .role = .follower,
        .peer = "author@laptop",
        .started_ms = 10,
        .writer_is_me = false,
    };
    try acceptHandoff(&follower, "author@laptop");
    try testing.expectEqual(Role.author, follower.role);
    try testing.expect(canWrite(follower));
