    const alloc = testing.allocator;
    const ops = try diffLines(alloc, "a\nb\nc\n", "a\nb\nc\n");
    defer alloc.free(ops);
    try testing.expectEqual(@as(usize, 3), ops.len);
    for (ops) |op| try testing.expect(op.tag == .keep);
}

