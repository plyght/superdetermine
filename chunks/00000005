	{GIT_CONFIGMAP_FALSE, NULL, GIT_EOL_UNSET},
	{GIT_CONFIGMAP_STRING, "lf", GIT_EOL_LF},
	{GIT_CONFIGMAP_STRING, "crlf", GIT_EOL_CRLF},
	{GIT_CONFIGMAP_STRING, "native", GIT_EOL_NATIVE}
