    defer c.git_reference_free(head_ref);
    var commit_obj: ?*c.git_object = null;
    try check(c.git_reference_peel(&commit_obj, head_ref, c.GIT_OBJECT_COMMIT));
    defer c.git_object_free(commit_obj);
    var out_tree: ?*c.git_tree = null;
