	cl_assert_equal_i(1, g);

	git_config_free(config);
	git_repository_free(repo);

	cl_setenv("GIT_CONFIG_NOSYSTEM", NULL);
	cl_setenv("GIT_CONFIG_SYSTEM", NULL);
	cl_setenv("GIT_CONFIG_GLOBAL", NULL);
}
