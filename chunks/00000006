    if ((allowed_types & @as(c_uint, c.GIT_CREDENTIAL_SSH_KEY)) != 0) {
        const user: [*c]const u8 = if (username_from_url != null) username_from_url else "git";
        return c.git_credential_ssh_key_from_agent(out, user);
    }
    return -1;
