    alloc: std.mem.Allocator,

    fn init(alloc: std.mem.Allocator) Writer {
        return .{ .list = .empty, .alloc = alloc };
    }
    fn deinit(self: *Writer) void {
        self.list.deinit(self.alloc);
    }
    fn byte(self: *Writer, b: u8) !void {
