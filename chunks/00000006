const usage =
    \\gr ‚Äî guardrail, a fast independent VCS built for humans and agents
    \\
    \\usage: gr <command> [args]
    \\
    \\the everyday loop
    \\  save [-m msg]   checkpoint the working tree (--prompt records who/why)
    \\  status | st     what changed since the last save
