int git_oid_cpy(git_oid *out, const git_oid *src)
{
	size_t size;

	if (!(size = git_oid_size(git_oid_type(src))))
		return oid_error_invalid("unknown type");

#ifdef GIT_EXPERIMENTAL_SHA256
	out->type = src->type;
