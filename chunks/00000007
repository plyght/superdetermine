fn waitFor(io: std.Io, budget_ms: u64, ctx: anytype) bool {
    var waited: u64 = 0;
    while (waited < budget_ms) : (waited += 50) {
        if (ctx.ready()) return true;
        sleepMs(io, 50);
    }
    return ctx.ready();
}

