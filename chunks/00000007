    const alloc = testing.allocator;
    var f = try fixture(alloc);
    defer f.deinit(alloc);

    const set = checks.Settings{ .enabled = true, .full = "true" };
    const ctx = f.ctx(alloc, set);

    for (0..10) |i| {
