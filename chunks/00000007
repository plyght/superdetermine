fn looksRemote(s: []const u8) bool {
    if (std.mem.indexOf(u8, s, "://") != null) return true;
    if (std.mem.startsWith(u8, s, "git@")) return true;
    if (std.mem.indexOfScalar(u8, s, '@')) |at| {
        if (std.mem.indexOfScalarPos(u8, s, at, ':') != null) return true;
    }
    return false;
}

