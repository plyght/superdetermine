test "importHead from a libgit2-created repo" {
    ensureInit();
    const io = std.testing.io;
    const alloc = testing.allocator;

    var tmp = std.testing.tmpDir(.{});
    defer tmp.cleanup();

    // Create git repo in a subdir of the tmp dir.
    try tmp.dir.createDirPath(io, "gitrepo");
