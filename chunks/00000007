if [ "${CMAKE_GENERATOR}" = "Unix Makefiles" -a "${CORES}" != "" -a "${CMAKE_BUILD_OPTIONS}" = "" ]; then
	BUILDER=(make -j ${CORES})
else
	BUILDER=("${CMAKE}" --build . ${CMAKE_BUILD_OPTIONS})
fi

echo "${BUILDER[@]}"
env PATH="${BUILD_PATH}" "${BUILDER[@]}"
