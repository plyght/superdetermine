	cl_git_pass(git_revwalk_new(&walk, repo));
	cl_git_pass(git_revwalk_push(walk, &third_oid));
	num_commits = 0;
	while ((error = git_revwalk_next(&oid, walk)) == GIT_OK) {
		num_commits++;
