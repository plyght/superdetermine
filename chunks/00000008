    defer store.deinit();

    try work.writeFile(io, .{ .sub_path = "a.txt", .data = "one" });
    const ctx = grade.Context{
        .store = &store,
        .work_dir = work,
        .alloc = alloc,
        .set = .{},
        .rules = .{},
    };
    _ = try tick(&store, work, ctx, .{ .enabled = true }, .{ .battery_floor = 0 });
