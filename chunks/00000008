    const folded = try f.store.readChange(chain[0]);
    defer object.freeChange(alloc, folded);
    const tree = try f.store.readTree(folded.tree);
    defer object.freeTree(alloc, tree);
    var found: ?Oid = null;
    for (tree.entries) |e| {
        if (eq(e.path, "app.zig")) found = e.blob;
