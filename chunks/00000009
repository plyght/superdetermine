        .sender => confirm_sender_label,
        .receiver => confirm_receiver_label,
    };
    var h = Blake3.init(.{ .key = session });
    h.update(label);
    h.update(&transcript);
    var out: [confirm_len]u8 = undefined;
    h.final(&out);
    return out;
}

