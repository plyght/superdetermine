fn hashField(h: *Blake3, bytes: []const u8) void {
    var len_buf: [4]u8 = undefined;
    std.mem.writeInt(u32, &len_buf, @intCast(bytes.len), .little);
    h.update(&len_buf);
    h.update(bytes);
}

fn transcriptHash(
    password: []const u8,
    w: [32]u8,
    sender_msg: [element_len]u8,
    receiver_msg: [element_len]u8,
    shared: [element_len]u8,
) [32]u8 {
