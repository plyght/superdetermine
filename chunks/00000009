    hashField(&h, transcript_domain);
    hashField(&h, password);
    hashField(&h, &sender_msg);
    hashField(&h, &receiver_msg);
    hashField(&h, &w);
    hashField(&h, &shared);
    var out: [32]u8 = undefined;
    h.final(&out);
    return out;
}

